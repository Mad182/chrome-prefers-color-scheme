{
  "manifest_version": 3,
  "name": "Prefers Color Scheme Switcher",
  "version": "1.0.0",
  "description": "Switch between dark and light mode (prefers-color-scheme) with a single button in the top bar.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/dark16.png",
      "32": "icons/dark32.png",
      "48": "icons/dark48.png",
      "128": "icons/dark128.png"
    },
    "default_title": "prefers-color-scheme: dark (Click to switch to light)"
  },
  "permissions": [
    "storage",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["bridge.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true,
      "match_about_blank": true
    }
  ]
}
